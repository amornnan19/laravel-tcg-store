# Plain HTTP on :8080. TLS, certificates and the public hostname belong to
# Coolify's Traefik; Laravel reads the X-Forwarded-* headers it adds
# (trustProxies in bootstrap/app.php).
{
	skip_install_trust
	auto_https off
	admin off
	frankenphp
}

:8080 {
	root /app/public
	encode zstd br gzip

	# Vite output is content-hashed, so it can be cached forever. Only files
	# that exist: a 404 for an asset from the next deploy must not stick.
	@build {
		path /build/assets/*
		file
	}
	header @build Cache-Control "public, max-age=31536000, immutable"

	header -Server

	php_server
}
