APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_REDIRECT_URI="${APP_URL}/auth/line/callback"
LINE_MESSAGING_CHANNEL_TOKEN=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SHOP_PROMPTPAY_ID=
SHOP_BANK_NAME=
SHOP_BANK_ACCOUNT_NAME=
SHOP_BANK_ACCOUNT_NUMBER=
SHOP_LINE_OA_URL=
# Shop timezone: dates a customer reads are shown in it (the app itself stores UTC).
SHOP_TIMEZONE=Asia/Bangkok
# Where customers post cards for the buylist. Several lines: "line one\nline two". Empty: the page says the shop will send it.
SHOP_BUYLIST_ADDRESS=
# Credit bonus on a buylist payout, in basis points (1500 = 15%).
BUYLIST_CREDIT_BONUS_BP=1500
# The card page's price chart says "sample data" while this is true; set false once the history is real.
SHOP_SAMPLE_PRICE_HISTORY=true
# true: `db:seed` also loads demo orders, price history, graded cards, sealed products, pre-orders and buy prices.
# Local environments always load them; accounts with a known password are only ever created locally.
SHOP_DEMO_DATA=false

# Shipping rates in satang (the defaults are the design's), protective packing, and graded-card insurance.
SHIPPING_FLASH_SATANG=4000
SHIPPING_KERRY_SATANG=5000
SHIPPING_JT_SATANG=4000
SHIPPING_THAIPOST_SATANG=3500
SHIPPING_PROTECTION_SATANG=3000
SHIPPING_PROTECTION_THRESHOLD_SATANG=50000
SHIPPING_GRADED_INSURANCE_SATANG=20000

# Production compose only (compose.production.yaml): the Meilisearch master key, also sent to the app as MEILISEARCH_KEY.
MEILI_MASTER_KEY=
